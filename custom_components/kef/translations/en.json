{
  "config": {
    "flow_title": "{title}",
    "step": {
      "user": {
        "title": "Add KEF speaker",
        "description": "Enter the host or IP address of your KEF speaker. Leave the password blank for first-generation LSX and LS50 Wireless speakers. For newer speakers, enter the speaker's web interface password only if one is configured.{diagnostics}",
        "data": {
          "host": "Host or IP address",
          "password": "Web UI password"
        }
      },
      "confirm": {
        "title": "Set up {title}",
        "description": "Do you want to set up {title}? If a password field is shown, leave it blank unless the speaker has a web interface password configured.{diagnostics}",
        "data": {
          "password": "Web UI password"
        }
      },
      "reconfigure": {
        "title": "Reconfigure KEF",
        "description": "Update the network details for this KEF device.{diagnostics}",
        "data": {
          "host": "Host or IP address",
          "password": "Web UI password"
        }
      },
      "reauth_confirm": {
        "title": "Update KEF password",
        "description": "Enter the web UI password for {title}.{diagnostics}",
        "data": {
          "password": "Web UI password"
        }
      }
    },
    "error": {
      "cannot_connect": "Failed to connect to the KEF speaker",
      "invalid_auth": "The KEF web UI password is invalid",
      "unsupported": "No supported KEF API was detected"
    },
    "abort": {
      "already_configured": "This KEF speaker is already configured",
      "reauth_successful": "The KEF password was updated",
      "reconfigure_successful": "The KEF connection was updated",
      "unsupported": "This discovered device is not a supported KEF speaker"
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "KEF options",
        "data": {
          "password": "Web UI password",
          "scan_interval": "Polling interval",
          "offline_retry_interval": "Offline retry interval",
          "enable_diagnostics": "Expose diagnostic sensors",
          "enable_eq_sensors": "Expose EQ read-only sensors (advanced)"
        },
        "data_description": {
          "password": "Only needed when the speaker's web interface is password protected. Leave empty otherwise.",
          "scan_interval": "How often the speaker is checked while it is online. On newer speakers, changes made in the KEF app or on the speaker arrive right away through the live event queue, and polling is the fallback. Lower is more responsive, higher means less network traffic.",
          "offline_retry_interval": "How often a speaker that stopped responding is checked again, for example when its power is switched off. A speaker counts as offline after three missed polls in a row. When it powers up, it announces itself on the network and reconnects right away, so this interval only matters if that announcement is missed.",
          "enable_diagnostics": "Adds extra sensors for troubleshooting: Wi-Fi signal and network details, speed test results, alarm and timer counts, and raw audio values. Leave off to keep the device page tidy."
        }
      }
    }
  },
